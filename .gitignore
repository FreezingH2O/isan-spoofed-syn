# ── Data — generated audio (large binary, not committed) ──────────────────────
data/raw_dataset/*.wav
data/tts_output/
data/speakers/
data/augmented/

# keep folder placeholders and user input texts
!data/raw_dataset/.gitkeep
!data/normalized_text/input/
!data/normalized_text/input/*.txt

# normalized outputs are generated — ignore them
data/normalized_text/*.normalized.txt
data/normalized_text/manifest.json

# ── Model weights (large binary, not committed) ────────────────────────────────
models/rvc/*.pth
models/rvc/*.index
models/contentvec/*.pt
models/contentvec/*.bin

# ── Output audio (large binary, not committed) ────────────────────────────────
output/spoofed/
output/enhanced/

